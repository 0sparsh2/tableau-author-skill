{
 "name": "Customer Geography",
 "data_model": {
  "links": [
   {
    "kind": "relationship",
    "left": "orders.csv",
    "right": "customers.csv",
    "left_field": "Customer ID",
    "right_field": "Customer ID (customers.csv)",
    "join_type": null
   }
  ]
 },
 "parameters": [
  {
   "name": "Top N",
   "datatype": "integer",
   "value": 10,
   "allowed": null,
   "min": 3,
   "max": 25,
   "step": 1
  },
  {
   "name": "Selected State",
   "datatype": "string",
   "value": "California",
   "allowed": null,
   "min": null,
   "max": null,
   "step": null
  }
 ],
 "calculations": [
  {
   "name": "Profit Ratio",
   "formula": "SUM([Profit]) / SUM([Sales])",
   "datatype": "real"
  },
  {
   "name": "Is Selected State",
   "formula": "IF [State] = [Selected State] THEN \"Selected\" ELSE \"Other\" END",
   "datatype": "string"
  }
 ],
 "formats": [
  {
   "field": "Sales",
   "format": "currency"
  },
  {
   "field": "Profit",
   "format": "currency"
  },
  {
   "field": "Profit Ratio",
   "format": "percent"
  }
 ],
